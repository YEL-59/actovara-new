# Copy to .env.local and adjust as needed.

# FRONTEND_FIRST: true (default) serves the in-memory demo data from src/mocks.
# Set to false once the PostgreSQL + Prisma backend API is running (Phase B).
NEXT_PUBLIC_USE_MOCKS=true

# Actovara REST API base URL (PostgreSQL + Prisma backend, used when NEXT_PUBLIC_USE_MOCKS=false).
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Show the /dev/ui component gallery in production builds.
NEXT_PUBLIC_ENABLE_UI_KIT=false

# P1? CSV import wizard in Settings (Q-008). Disabled until confirmed in MVP scope.
NEXT_PUBLIC_ENABLE_CSV_IMPORT=false
